# Скопируйте в .env в корне проекта и задайте собственные секреты.
DB_PASSWORD=
JWT_SECRET=
INTERNAL_API_TOKEN=

# Без ключа DeepSeek ML возвращает категории с пустыми title/text.
GENERATOR_PROVIDER=disabled
DEEPSEEK_API_KEY=

# При изменении режима ML при необходимости увеличьте таймауты.
ML_READ_TIMEOUT=120s
DEEPSEEK_TIMEOUT_SECONDS=12
DEEPSEEK_MAX_RETRIES=1
